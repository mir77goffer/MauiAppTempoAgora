<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppTempoAgora.MainPage"
    Title="Tempo Agora">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18">

            <Label
                Text="Consulta do tempo"
                FontSize="24"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_cidade"
                Placeholder="Digite o nome da cidade"
                ClearButtonVisibility="WhileEditing" />

            <Button
                Text="Buscar"
                Clicked="Button_Clicked" />

            <ActivityIndicator
                x:Name="loading"
                IsVisible="False"
                IsRunning="False" />

            <Label
                x:Name="lbl_res"
                FontSize="16"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>